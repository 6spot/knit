{
  "knit": {
    "SessionStart": [
      { "type": "command", "command": "knit hook agy SessionStart" }
    ],
    "PreInvocation": [
      { "type": "command", "command": "knit hook agy PreInvocation" }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "knit hook agy PreToolUse" }]
      }
    ]
  }
}
