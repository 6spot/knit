{
  "schemaVersion": 1,
  "client": {
    "default": "pi"
  },
  "agent": {
    "runtime": "pi",
    "resume": "prefer"
  },
  "execution": {
    "host": "auto"
  },
  "delivery": {
    "mode": "local"
  },
  "workflow": {
    "maxRepairRounds": 2
  },
  "phases": {
    "implement": { "model": "magpie/group/deepseek" },
    "check": { "model": "magpie/group/deepseek" },
    "advisory": { "model": "magpie/group/deepseek" }
  },
  "limits": {
    "heartbeatIntervalMs": 5000,
    "heartbeatStaleMs": 30000,
    "cancelGraceMs": 5000,
    "snapshotsMaxBytes": 67108864,
    "storageWarnBytes": 536870912
  }
}
