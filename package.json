{
  "name": "knit",
  "version": "0.1.0",
  "private": true,
  "description": "轻量项目辅助 CLI：项目资料、任务、规范演进、实施／检查、提交归档与恢复。",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "knit": "dist/cli/knit.js"
  },
  "files": [
    "assets/",
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/knit.js && npm run -s build:agy-tracker",
    "build:agy-tracker": "if [ \"$(uname -s)\" = Darwin ] && /usr/bin/xcode-select -p >/dev/null 2>&1; then /usr/bin/cc -O2 -Wall -Wextra -o dist/adapters/antigravity/command-processes src/adapters/antigravity/command-processes.c; fi",
    "test": "npm run -s build && node --test \"test/*.test.mjs\"",
    "pack:check": "npm run -s build && node scripts/pack-check.mjs",
    "pack:install": "node scripts/pack-install.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0",
    "commander": "15.0.0",
    "re2js": "2.10.0",
    "sh-syntax": "0.8.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
