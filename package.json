{
  "name": "knit",
  "version": "0.1.0",
  "private": true,
  "description": "轻量项目辅助 CLI：项目资料、任务、规范演进、实施／检查、提交归档与恢复。",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "knit": "dist/cli/knit.js"
  },
  "files": [
    "assets/",
    "dist/"
  ],
  "scripts": {
    "build:next": "rm -rf next/dist && tsc -p next/tsconfig.json",
    "test:next": "npm run -s build:next && node --test \"next/test/*.test.mjs\""
  },
  "dependencies": {
    "@earendil-works/pi-schema": "1.5.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  }
}
